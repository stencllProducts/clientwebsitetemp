{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", "app/page.js", "app/layout.js", "assets/index.js", "components/Loader.js", "components/MenuButton.js", "components/NavBar.js", "components/ToastProvider.js", "utils/toaster.js", "components/homepage/index.js", "components/homepage/Hero.js", "components/homepage/Footer.js", "components/homepage/Features.js", "components/homepage/ContactUs.js", "components/homepage/ChooseYourPlan.js"],
  "exclude": ["node_modules"]
}
